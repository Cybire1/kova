# What EAS uploads to build the iOS app. The app (apps/mobile) reaches only packages/monad, so the
# rest of the repo stays here: the film's audio alone is ~200 MB. When this file exists, EAS reads
# it instead of every .gitignore, so it repeats what must never leave the machine.

# Not part of the iOS app
film/
docs/
apps/api/
apps/web/
apps/card/
apps/rates/
packages/db/
packages/tempo/

# Dependencies, builds and secrets (from .gitignore)
node_modules/
node_modules/
.git
.aws/
.codex/
.agents/
dist/
.next/
.turbo/
.expo/
coverage/
*.log
.env
.env.*
!.env.example
.DS_Store
*.tsbuildinfo
next-env.d.ts

# The app's own (from apps/mobile/.gitignore): generated native folders, keys, local files
apps/mobile/ios/
apps/mobile/android/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
apps/mobile/app-example
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
# card build output
card/**/build/
*.cap
# Next writes these per-app on dev runs
apps/web/AGENTS.md
apps/web/CLAUDE.md
next-env.d.ts

# Expo native projects are generated by `expo prebuild`
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/

# Video sources and renders are not part of the mobile app.
film/
vedit/
