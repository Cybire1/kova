# Kova API (Monad build): copy to .env for local development. Every variable is optional except
# where noted; see src/config.ts for the full list.
KOVA_NETWORK=testnet
DATABASE_URL=postgres://localhost:5432/kova_dev
PORT=4000

# The relayer: it submits the payments people sign and pays their gas in MON.
# `pnpm --filter @kova/api setup:dev` generates one into .env.monad (testnet only). Fund it with
# testnet MON at https://faucet.monad.xyz. On mainnet this is a KMS key, never an env var.
# KOVA_FEE_PAYER_PRIVATE_KEY=0x...

# A provider RPC in production (defaults to Monad's public RPC).
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# KovaRates on Monad, written by the Chainlink CRE workflow in apps/rates (Monad testnet below).
# Unset: a fixed reference table, labelled as such in the app.
KOVA_RATES_ADDRESS=0xb5322DC6d6AA938C50859f0f0e2DF7b6Da4C9e8e

# The sites shops may sign in from with their wallet (EIP-4361). Defaults to mykova.app plus
# localhost outside production.
# KOVA_SIGN_IN_DOMAINS=localhost:3000

# Shared with the web app so rate limits count visitors, not the web server. 32+ characters.
# KOVA_PROXY_SECRET=

# Optional features:
# ANTHROPIC_API_KEY=        # "Snap your menu" (reads a menu photo into catalogue items), or
# DEEPSEEK_API_KEY=         # DeepSeek instead; KOVA_MENU_PROVIDER picks one when both are set
# DUFFEL_API_KEY=           # Kova Travel: flights and hotels (a duffel_test_ key for test mode)
# TYPESAFE_API_KEY=         # Jev: spending categories and order-note flags
# Money in, the dollar card and savings (each says "Request access" until its key is set):
# BRIDGE_API_KEY=           # A US account number per wallet (Bridge virtual accounts); onboarding via support@bridge.xyz
# BRIDGE_API_URL=           # https://api.sandbox.bridge.xyz (default) or https://api.bridge.xyz
# LITHIC_API_KEY=           # The dollar card (Lithic virtual cards); sandbox keys are self-serve at lithic.com
# LITHIC_API_URL=           # https://sandbox.lithic.com (default) or https://api.lithic.com
# LITHIC_ASA_SECRET=        # whsec_… : Lithic's signing secret for card authorizations (Auth Stream Access)
# KOVA_SAVINGS_VAULT=       # An ERC-4626 vault for AUSD (on testnet: KovaTestVault from apps/card/contracts)
# KOVA_SAVER=               # KovaSaver in front of it (script/DeploySavings.s.sol prints both)
# KOVA_SAVINGS_WALLETS=     # Who can save: wallet addresses, comma-separated, or `everyone`.
#                           #   Unset: everyone on testnet, nobody on mainnet (docs/savings.md)
# KOVA_SAVINGS_RATE_VAULT=  # Where to read the recent rate if the vault is newer than a week
# KOVA_SAVINGS_AUDITED=     # 1 once the vault is audited; until then the app says it's in beta

# Buying and selling xStocks (docs/stocks-trading.md), Monad mainnet only. Off unless 1.
# KOVA_STOCKS_TRADING=1
# KOVA_STOCKS_CONTRACT=     # KovaStocks (apps/card/contracts/src/KovaStocks.sol)

# Crypto deposits: MON and supported assets from other chains arrive as AUSD on Monad mainnet.
# The key is required for deposit tracking; keep it on the API, never in a client bundle.
# RELAY_API_KEY=
KOVA_CHAIN_DEPOSITS=1
# Card and bank top-ups with MoonPay (dashboard.moonpay.com → Developers). MoonPay buys USDC on Base
# into the wallet's deposit address and Relay makes it AUSD, so this also needs RELAY_API_KEY. The
# secret key signs every link; keep it on the API. pk_test_/sk_test_ open MoonPay's sandbox.
# MOONPAY_PUBLISHABLE_KEY=pk_live_…
# MOONPAY_SECRET_KEY=sk_live_…
KOVA_PHONE_SEND_ENABLED=0
# Optional public origin for SMS invitations (for example, a custom domain hosting the testnet demo).
# KOVA_PHONE_WEB_URL=https://mykova.app
