{
  "name": "@kova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.monad src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "setup:dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad src/scripts/setup-dev.ts",
    "test:e2e": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad ./node_modules/vitest/vitest.mjs run",
    "demo:payments": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad src/scripts/demo-payments.ts",
    "pay:open": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad src/scripts/pay-open.ts",
    "perf": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad src/scripts/profile.ts",
    "pay:checkout": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad src/scripts/pay-checkout.ts",
    "menu:read": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.monad src/scripts/read-menu.ts",
    "mainnet:check": "tsx --env-file=.env.mainnet src/scripts/mainnet-check.ts",
    "check:private": "tsx src/scripts/private-check.ts",
    "check:naira": "tsx --env-file-if-exists=.env src/scripts/naira-check.ts",
    "check:offline": "tsx src/scripts/offline-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@duffel/api": "^4.30.0",
    "@hono/node-server": "2.1.1",
    "@kova/db": "workspace:*",
    "@kova/monad": "workspace:*",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "ox": "0.14.45",
    "viem": "2.56.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
