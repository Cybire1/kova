# Public builds use Monad mainnet. The production EAS profile pins these values explicitly.
EXPO_PUBLIC_KOVA_NETWORK=mainnet
EXPO_PUBLIC_KOVA_MONAD_API_URL=https://api-monad-mainnet.up.railway.app
EXPO_PUBLIC_KOVA_MONAD_WEB_URL=https://mykova.app
EXPO_PUBLIC_PRIVY_APP_ID=cmufz0ix501jn0cl6z2vdou5a
# Privy Dashboard → App settings → Clients: mobile client, app ID xyz.kova.pay.monad, scheme kova.
# EXPO_PUBLIC_PRIVY_CLIENT_ID=

# To use a local API
# instead (on a device, localhost is the device: use your Mac's LAN IP):
# EXPO_PUBLIC_KOVA_MONAD_API_URL=http://localhost:4000
# EXPO_PUBLIC_KOVA_MONAD_WEB_URL=http://localhost:3000
# Development only. A shipped terminal registers for a device token instead.
EXPO_PUBLIC_KOVA_API_KEY=kova_test_sk_...
