{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_KOVA_NETWORK": "mainnet",
        "EXPO_PUBLIC_KOVA_MONAD_API_URL": "https://api-monad-mainnet.up.railway.app",
        "EXPO_PUBLIC_KOVA_MONAD_WEB_URL": "https://mykova.app"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_KOVA_NETWORK": "testnet",
        "EXPO_PUBLIC_KOVA_MONAD_API_URL": "https://api-monad.up.railway.app"
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "5N8DU2A9WH",
        "ascAppId": "6819066097"
      }
    }
  }
}
